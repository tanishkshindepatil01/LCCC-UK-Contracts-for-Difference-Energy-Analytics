      <aliases enabled='yes' />
      <column caption='Generation TWh' datatype='real' name='[Calculation_4854673335877633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric] = &quot;CfD generation&quot;&#10;AND [record_group] = &quot;Historical unit-month&quot;&#10;THEN [value] / 1000000&#10;END' />
      </column>
      <column caption='Avoided Emissions MtCO2e' datatype='real' name='[Calculation_4854673339748354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric] = &quot;Estimated avoided GHG&quot;&#10;AND [record_group] = &quot;Historical unit-month&quot;&#10;THEN [value] / 1000000&#10;END' />
      </column>
      <column caption='Contract Capacity GW' datatype='real' name='[Calculation_4854673342943236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric] = &quot;Maximum contract capacity&quot;&#10;AND [record_group] = &quot;Portfolio contract snapshot&quot;&#10;AND [status] &lt;&gt; &quot;Terminated&quot;&#10;THEN [value] / 1000&#10;END' />
      </column>
      <column caption='Net CfD Payments GBPbn' datatype='real' name='[Calculation_4854673346322437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric] = &quot;Net CfD payments&quot;&#10;AND [record_group] = &quot;Historical unit-month&quot;&#10;THEN [value] / 1000000000&#10;END' />
      </column>
      <column caption='Weighted Strike Price GBP/MWh' datatype='real' name='[Calculation_4854673347842054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [metric] = &quot;Generation x strike price&quot;&#10;    AND [record_group] = &quot;Historical unit-month&quot;&#10;    THEN [value]&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [metric] = &quot;CfD generation&quot;&#10;    AND [record_group] = &quot;Historical unit-month&quot;&#10;    THEN [value]&#10;    END&#10;)' />
      </column>
      <column caption='Weighted Reference Price GBP/MWh' datatype='real' name='[Calculation_4854673347907591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [metric] = &quot;Generation x reference price&quot;&#10;    AND [record_group] = &quot;Historical unit-month&quot;&#10;    THEN [value]&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [metric] = &quot;CfD generation&quot;&#10;    AND [record_group] = &quot;Historical unit-month&quot;&#10;    THEN [value]&#10;    END&#10;)' />
      </column>
      <column caption='Auction Strike Price GBP/MWh' datatype='real' name='[Calculation_4854673351938056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [record_group] = &quot;Auction award&quot;&#10;AND [metric] = &quot;Award strike price&quot;&#10;THEN [value]&#10;END' />
      </column>
      <column caption='Initial CfD Forecast GBPm' datatype='real' name='[Calculation_4854673389658121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [record_group] = &quot;Payment forecast day&quot;&#10;AND [metric] = &quot;Initial forecast CfD payments&quot;&#10;THEN [value] / 1000000&#10;END' />
      </column>
      <column caption='Latest CfD Forecast GBPm' datatype='real' name='[Calculation_4854673389793291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [record_group] = &quot;Payment forecast day&quot;&#10;AND [metric] = &quot;Latest forecast CfD payments&quot;&#10;THEN [value] / 1000000&#10;END' />
      </column>
      <column caption='Monthly Forecast Revision GBPm' datatype='real' name='[Calculation_4854673391091724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_4854673389793291]))&#10;-&#10;ZN(SUM([Calculation_4854673389658121]))' />
